       IDENTIFICATION DIVISION.
       PROGRAM-ID. REVERSE-STRING.
       DATA DIVISION.
       WORKING-STORAGE SECTION.
       01 INPUT-TEXT PIC X(30).
       01 OUTPUT-TEXT PIC X(30).
       01 TEXT-LENGTH PIC 99 VALUE 30.
       01 I PIC 99.
       01 J PIC 99.
       PROCEDURE DIVISION.
           DISPLAY "Enter text: " WITH NO ADVANCING.
           ACCEPT INPUT-TEXT.
           MOVE 30 TO TEXT-LENGTH.
           PERFORM UNTIL TEXT-LENGTH = 1
               OR INPUT-TEXT(TEXT-LENGTH:1) NOT = SPACE
               SUBTRACT 1 FROM TEXT-LENGTH
           END-PERFORM.
           MOVE SPACES TO OUTPUT-TEXT.
           PERFORM VARYING I FROM 1 BY 1 UNTIL I > TEXT-LENGTH
               COMPUTE J = TEXT-LENGTH - I + 1
               MOVE INPUT-TEXT(J:1) TO OUTPUT-TEXT(I:1)
           END-PERFORM.
           DISPLAY "Reversed: " OUTPUT-TEXT(1:TEXT-LENGTH).
           STOP RUN.
